# ==============================================================================
# Dynamic Reverse Proxy Configuration
# Managed by Ansible (port_forward role) - DO NOT EDIT MANUALLY
# ==============================================================================

# Map connection upgrade for seamless WebSocket support across all proxy blocks
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

{% for m in port_forward_normalized_mappings %}
# ------------------------------------------------------------------------------
# Mapping: Public Port {{ m.public_port }} -> http://{{ m.local_host }}:{{ m.local_port }}
# ------------------------------------------------------------------------------
server {
    listen {{ m.public_port }}{% if m.public_port | int == 80 %} default_server{% endif %};
    listen [::]:{{ m.public_port }}{% if m.public_port | int == 80 %} default_server{% endif %};
    server_name _;

{% if port_forward_auth_active | bool and (m.auth | default(true)) %}
    # HTTP Basic Authentication
    auth_basic "{{ port_forward_auth_realm }}";
    auth_basic_user_file /etc/nginx/.htpasswd;
{% endif %}

    # Disable upload size limit to prevent HTTP 413 Request Entity Too Large
    client_max_body_size {{ port_forward_client_max_body_size }};

    # Long timeouts for streaming, interactive terminals, and WebSocket stability
    proxy_read_timeout {{ port_forward_proxy_timeout }};
    proxy_send_timeout {{ port_forward_proxy_timeout }};
    proxy_connect_timeout 60s;

    # Disable buffering for real-time output (Jupyter kernels, logs, SSE)
    proxy_buffering off;
    proxy_cache off;

{% if port_forward_block_downloads_active | bool %}
    # --------------------------------------------------------------------------
    # Download Prevention Rules
    # --------------------------------------------------------------------------
{% if port_forward_block_jupyter_files | default(true) | bool %}
    # Block direct file download endpoint (/files/...)
    location ^~ /files/ {
        return 403;
    }
{% endif %}

{% if port_forward_block_jupyter_nbconvert | default(true) | bool %}
    # Block notebook export and download conversions (/nbconvert/...)
    location ^~ /nbconvert/ {
        return 403;
    }
{% endif %}

    # Block direct downloads of common datasets, archives, documents & binaries
    location ~* \.({{ port_forward_blocked_extensions | default('zip|tar|gz|tgz|bz2|7z|rar|csv|tsv|parquet|db|sqlite|sql|xlsx?|docx?|pptx?|pdf|exe|sh|bin') }})$ {
        return 403;
    }
{% endif %}

    location / {
{% if port_forward_block_downloads_active | bool %}
        # Block downloads triggered via query parameter (e.g. ?download=1)
        if ($arg_download) {
            return 403;
        }

        # Suppress attachment headers to prevent forced browser file saves
        proxy_hide_header Content-Disposition;
{% endif %}

        proxy_pass http://{{ m.local_host }}:{{ m.local_port }};
        proxy_http_version 1.1;

{% if port_forward_enable_websocket | bool %}
        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
{% endif %}

        # Standard proxy headers
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Prevent backend redirects from leaking internal localhost address
        proxy_redirect http://{{ m.local_host }}:{{ m.local_port }}/ /;
        proxy_redirect http://localhost:{{ m.local_port }}/ /;
    }

{% if port_forward_auth_active | bool and (m.auth | default(true)) %}
    # Exempt background API and terminal WebSocket calls from Basic Auth
    # to avoid header conflicts with application tokens (such as Jupyter Authorization: token)
    location ~ ^/(api|terminals|lsp)/ {
        auth_basic off;

{% if port_forward_block_downloads_active | bool %}
        # Prevent API-level downloads (e.g. /api/contents/... ?download=1)
        if ($arg_download) {
            return 403;
        }

        proxy_hide_header Content-Disposition;
{% endif %}

        proxy_pass http://{{ m.local_host }}:{{ m.local_port }};
        proxy_http_version 1.1;

{% if port_forward_enable_websocket | bool %}
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
{% endif %}

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_read_timeout {{ port_forward_proxy_timeout }};
        proxy_send_timeout {{ port_forward_proxy_timeout }};
        proxy_buffering off;
        proxy_cache off;
    }
{% endif %}
}

{% endfor %}
