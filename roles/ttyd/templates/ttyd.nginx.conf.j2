# ==============================================================================
# Nginx Reverse Proxy Configuration for ttyd Web Terminal
# Managed by Ansible - DO NOT EDIT MANUALLY
# ==============================================================================

# Map connection upgrade dynamically for WebSockets
map $http_upgrade $ttyd_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen {{ ttyd_nginx_port }}{% if ttyd_nginx_port | int == 80 and ttyd_nginx_server_name == '_' %} default_server{% endif %};
    listen [::]:{{ ttyd_nginx_port }}{% if ttyd_nginx_port | int == 80 and ttyd_nginx_server_name == '_' %} default_server{% endif %};
    server_name {{ ttyd_nginx_server_name }};

    # HTTP Basic Authentication
    auth_basic "{{ ttyd_auth_realm }}";
    auth_basic_user_file /etc/nginx/.htpasswd_ttyd;

    # Disable upload size limit
    client_max_body_size 0;

    # Long timeouts for persistent web terminal sessions
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
    proxy_connect_timeout 60s;

    # Disable buffering for instant keystroke rendering and terminal output
    proxy_buffering off;
    proxy_cache off;

    location / {
        proxy_pass http://{{ ttyd_bind_ip }}:{{ ttyd_bind_port }};
        proxy_http_version 1.1;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ttyd_connection_upgrade;

        # Standard reverse proxy headers
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Prevent backend redirects from leaking internal IP/port
        proxy_redirect http://{{ ttyd_bind_ip }}:{{ ttyd_bind_port }}/ /;
        proxy_redirect http://localhost:{{ ttyd_bind_port }}/ /;
    }
}
